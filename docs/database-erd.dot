digraph ERD {
  graph [rankdir=LR, pad=0.4, nodesep=0.5, ranksep=1.1, fontname="Helvetica", label="Collaborative Kanban - ER diagram   (★ = tenant_id isolation column; composite FKs on (id, tenant_id) stop cross-tenant references)", labelloc=t, fontsize=16];
  node [shape=plain, fontname="Helvetica", fontsize=11];
  edge [fontname="Helvetica", fontsize=9, color="#475569", arrowhead=crow, arrowtail=tee, dir=both];
  organizations [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#e0e7ff"><B>organizations</B></TD></TR><TR><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">UUID</FONT></TD><TD ALIGN="LEFT"><B>PK</B></TD></TR><TR><TD ALIGN="LEFT">name</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">VARCHAR</FONT></TD><TD ALIGN="LEFT"></TD></TR><TR><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">TIMESTAMPTZ</FONT></TD><TD ALIGN="LEFT"></TD></TR><TR><TD ALIGN="LEFT">updated_at</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">TIMESTAMPTZ</FONT></TD><TD ALIGN="LEFT"></TD></TR></TABLE>>];
  tenants [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#dbeafe"><B>tenants</B></TD></TR><TR><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">UUID</FONT></TD><TD ALIGN="LEFT"><B>PK</B></TD></TR><TR><TD ALIGN="LEFT">organization_id</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">UUID</FONT></TD><TD ALIGN="LEFT"><B>FK</B></TD></TR><TR><TD ALIGN="LEFT">name</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">VARCHAR</FONT></TD><TD ALIGN="LEFT"></TD></TR><TR><TD ALIGN="LEFT">created_at / updated_at</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">TIMESTAMPTZ</FONT></TD><TD ALIGN="LEFT"></TD></TR></TABLE>>];
  users [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#fce7f3"><B>users</B></TD></TR><TR><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">UUID</FONT></TD><TD ALIGN="LEFT"><B>PK</B></TD></TR><TR><TD ALIGN="LEFT">name</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">VARCHAR</FONT></TD><TD ALIGN="LEFT"></TD></TR><TR><TD ALIGN="LEFT">email</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">VARCHAR</FONT></TD><TD ALIGN="LEFT"><B>UQ</B></TD></TR><TR><TD ALIGN="LEFT">password_hash</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">VARCHAR</FONT></TD><TD ALIGN="LEFT"></TD></TR><TR><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">TIMESTAMPTZ</FONT></TD><TD ALIGN="LEFT"></TD></TR></TABLE>>];
  memberships [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#fae8ff"><B>memberships</B></TD></TR><TR><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">UUID</FONT></TD><TD ALIGN="LEFT"><B>PK</B></TD></TR><TR><TD ALIGN="LEFT">user_id</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">UUID</FONT></TD><TD ALIGN="LEFT"><B>FK</B></TD></TR><TR><TD ALIGN="LEFT">organization_id</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">UUID</FONT></TD><TD ALIGN="LEFT"><B>FK</B></TD></TR><TR><TD ALIGN="LEFT">tenant_id</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">UUID</FONT></TD><TD ALIGN="LEFT"><B>FK (null = org-level)</B></TD></TR><TR><TD ALIGN="LEFT">role</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">org_admin | tenant_admin | member</FONT></TD><TD ALIGN="LEFT"></TD></TR><TR><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">TIMESTAMPTZ</FONT></TD><TD ALIGN="LEFT"></TD></TR></TABLE>>];
  boards [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#dcfce7"><B>boards</B></TD></TR><TR><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">UUID</FONT></TD><TD ALIGN="LEFT"><B>PK</B></TD></TR><TR><TD ALIGN="LEFT">organization_id</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">UUID</FONT></TD><TD ALIGN="LEFT"><B>FK</B></TD></TR><TR><TD ALIGN="LEFT">tenant_id</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">UUID</FONT></TD><TD ALIGN="LEFT"><B>FK  ★</B></TD></TR><TR><TD ALIGN="LEFT">name</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">VARCHAR</FONT></TD><TD ALIGN="LEFT"></TD></TR><TR><TD ALIGN="LEFT">description</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">TEXT</FONT></TD><TD ALIGN="LEFT"></TD></TR><TR><TD ALIGN="LEFT">created_by</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">UUID</FONT></TD><TD ALIGN="LEFT"><B>FK</B></TD></TR><TR><TD ALIGN="LEFT">created_at / updated_at</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">TIMESTAMPTZ</FONT></TD><TD ALIGN="LEFT"></TD></TR></TABLE>>];
  columns [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#fef9c3"><B>columns</B></TD></TR><TR><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">UUID</FONT></TD><TD ALIGN="LEFT"><B>PK</B></TD></TR><TR><TD ALIGN="LEFT">board_id</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">UUID</FONT></TD><TD ALIGN="LEFT"><B>FK</B></TD></TR><TR><TD ALIGN="LEFT">tenant_id</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">UUID</FONT></TD><TD ALIGN="LEFT"><B>FK  ★</B></TD></TR><TR><TD ALIGN="LEFT">name</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">VARCHAR</FONT></TD><TD ALIGN="LEFT"></TD></TR><TR><TD ALIGN="LEFT">position</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">INTEGER</FONT></TD><TD ALIGN="LEFT"></TD></TR></TABLE>>];
  tasks [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#ffedd5"><B>tasks</B></TD></TR><TR><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">UUID</FONT></TD><TD ALIGN="LEFT"><B>PK</B></TD></TR><TR><TD ALIGN="LEFT">board_id</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">UUID</FONT></TD><TD ALIGN="LEFT"><B>FK</B></TD></TR><TR><TD ALIGN="LEFT">column_id</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">UUID</FONT></TD><TD ALIGN="LEFT"><B>FK</B></TD></TR><TR><TD ALIGN="LEFT">tenant_id</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">UUID</FONT></TD><TD ALIGN="LEFT"><B>FK  ★</B></TD></TR><TR><TD ALIGN="LEFT">title</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">VARCHAR</FONT></TD><TD ALIGN="LEFT"></TD></TR><TR><TD ALIGN="LEFT">description</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">TEXT</FONT></TD><TD ALIGN="LEFT"></TD></TR><TR><TD ALIGN="LEFT">assigned_to</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">UUID</FONT></TD><TD ALIGN="LEFT"><B>FK</B></TD></TR><TR><TD ALIGN="LEFT">created_by</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">UUID</FONT></TD><TD ALIGN="LEFT"><B>FK</B></TD></TR><TR><TD ALIGN="LEFT">priority</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">low|medium|high</FONT></TD><TD ALIGN="LEFT"></TD></TR><TR><TD ALIGN="LEFT">due_date</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">DATE</FONT></TD><TD ALIGN="LEFT"></TD></TR><TR><TD ALIGN="LEFT">labels</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">TEXT[]</FONT></TD><TD ALIGN="LEFT"></TD></TR><TR><TD ALIGN="LEFT">position</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">INTEGER</FONT></TD><TD ALIGN="LEFT"><B>order in column</B></TD></TR><TR><TD ALIGN="LEFT">version</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">INTEGER</FONT></TD><TD ALIGN="LEFT"><B>optimistic lock</B></TD></TR><TR><TD ALIGN="LEFT">created_at / updated_at</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">TIMESTAMPTZ</FONT></TD><TD ALIGN="LEFT"></TD></TR></TABLE>>];
  activity_logs [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#e5e7eb"><B>activity_logs</B></TD></TR><TR><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">UUID</FONT></TD><TD ALIGN="LEFT"><B>PK</B></TD></TR><TR><TD ALIGN="LEFT">tenant_id</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">UUID</FONT></TD><TD ALIGN="LEFT"><B>FK  ★</B></TD></TR><TR><TD ALIGN="LEFT">user_id</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">UUID</FONT></TD><TD ALIGN="LEFT"><B>FK</B></TD></TR><TR><TD ALIGN="LEFT">entity_type</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">VARCHAR</FONT></TD><TD ALIGN="LEFT"></TD></TR><TR><TD ALIGN="LEFT">entity_id</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">UUID</FONT></TD><TD ALIGN="LEFT"></TD></TR><TR><TD ALIGN="LEFT">action</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">VARCHAR</FONT></TD><TD ALIGN="LEFT"></TD></TR><TR><TD ALIGN="LEFT">details</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">JSONB</FONT></TD><TD ALIGN="LEFT"></TD></TR><TR><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">TIMESTAMPTZ</FONT></TD><TD ALIGN="LEFT"></TD></TR></TABLE>>];
  organizations -> tenants [label="1 : N"];
  organizations -> memberships [label="1 : N"];
  tenants -> memberships [label="1 : N"];
  users -> memberships [label="1 : N"];
  tenants -> boards [label="1 : N"];
  boards -> columns [label="1 : N"];
  columns -> tasks [label="1 : N"];
  boards -> tasks [label="1 : N"];
  tenants -> activity_logs [label="1 : N"];
  users -> activity_logs [label="1 : N"];
  users -> tasks [label="assigned_to / created_by"];
}